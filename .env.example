# Google Drive Cloud Sync (Client ID Google OAuth 2.0 Web Application)
# Compatible à la fois en dev local (Vite) et en production Docker
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Web3Forms Contact Form Access Key (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Port d'écoute HTTP pour Docker Compose (optionnel, défaut : 8080)
PORT=8080

